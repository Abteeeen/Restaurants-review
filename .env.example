# --- Discovery: Google Places API ---
GOOGLE_PLACES_API_KEY=

# --- Qualification: Hermes LLM (OpenAI-compatible chat completions endpoint) ---
# Hermes (Nous Research) models are served over an OpenAI-compatible API.
# Point these at whatever host serves your Hermes model:
#   - a local vLLM / llama.cpp / LM Studio server, or
#   - a hosted provider that serves a Hermes model.
# If HERMES_API_KEY is unset, qualification falls back to a deterministic
# heuristic so the demo still runs end-to-end.
HERMES_API_KEY=
HERMES_API_BASE=http://localhost:8000/v1
HERMES_MODEL=Hermes-3-Llama-3.1-8B

# --- Mail proof: Lob TEST mode only ---
# MUST be a test key (starts with "test_"). Live keys are rejected by the code.
LOB_TEST_KEY=

# --- Landing page / branding ---
# Base URL where the static landing pages are hosted. The QR code and
# postcard point here: {LANDING_BASE_URL}/r/{place_id}.html
LANDING_BASE_URL=https://cjstudios.example.com

# --- Pipeline tuning ---
REVIEW_THRESHOLD=20
SEARCH_RADIUS_METERS=8000
