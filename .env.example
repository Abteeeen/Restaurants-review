# --- Discovery: Google Places API ---
GOOGLE_PLACES_API_KEY=

# --- Qualification: OpenRouter (OpenAI-compatible chat completions) ---
# Required. Qualification calls OpenRouter live; there is NO heuristic
# fallback. A missing key, an unavailable model, or a failed call fails
# loudly (the affected rows are marked QUALIFICATION_FAILED).
OPENROUTER_API_KEY=
# Model id must exist in OpenRouter's /models list (verified at runtime).
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Mail proof: Lob TEST mode only ---
# MUST be a test key (starts with "test_"). Live keys are rejected by the code.
LOB_TEST_KEY=

# --- Landing page / branding ---
# Base URL where the static landing pages are hosted. The QR code and
# postcard point here: {LANDING_BASE_URL}/r/{place_id}.html
LANDING_BASE_URL=https://cjstudios.example.com

# --- Pipeline tuning ---
REVIEW_THRESHOLD=20
SEARCH_RADIUS_METERS=8000
